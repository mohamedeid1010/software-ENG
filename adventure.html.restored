    // --- GAMEPLAY CONTROLLER ---
    let currentQuestId = null;
    let currentStepIdx = 0;
    let typingIntervalId = null;

    // Load initial stats
    Player.loadStats();
    updateQuestGridBadges();

    function updateQuestGridBadges() {
      if (Player.completedQuests.includes(1)) {
        const badge = document.getElementById('q1-badge');
        badge.textContent = 'طھظ… ط§ظ„ط¥ظ†ط¬ط§ط² ًںڈ†';
