// MISSING LINE 1601
// MISSING LINE 1602
// MISSING LINE 1603
      AudioEngine.playClick();
      Player.hp = 100;
      Player.saveStats();
      document.getElementById('faint-screen').style.display = 'none';
      loadStep(); // retry step
    }

    function showCompleteScreen() {
      // Set rewards
      document.getElementById('reward-xp').textContent = 100;
      document.getElementById('reward-gold').textContent = 50;

      document.getElementById('complete-congrats-text').innerHTML = `يا بطل! لقد أنهيت <b>"${QuestData[currentQuestId].title}"</b> بنجاح وسرعت من كفاءة الشركة وأرضيت العميل. المهندس أبو عيد يحييك ويقول لك: <i>"رجل حقيقي وهندسة البرمجيات لعبتك!"</i>`;
      
      document.getElementById('complete-screen').style.display = 'flex';
      AudioEngine.playLevelUp();
    }

    function finishQuest() {
      AudioEngine.playClick();
      
      // Add rewards to stats
      Player.reward(100, 50);
      
      // Save completed quest id
      if (!Player.completedQuests.includes(currentQuestId)) {
        Player.completedQuests.push(currentQuestId);
        localStorage.setItem('se_quest_completed', JSON.stringify(Player.completedQuests));
      }

      // Hide overlays
      document.getElementById('complete-screen').style.display = 'none';
      document.getElementById('active-game-screen').style.display = 'none';
      
      // Update portal dashboard
      updateQuestGridBadges();
      document.getElementById('quest-selector-screen').style.display = 'flex';
    }
  </script>
</body>
</html>
