      damage(amount) {
        this.hp = Math.max(0, this.hp - amount);
        this.saveStats();
        if (this.hp <= 0) {
          showFaintScreen();
        }
      },

      reward(xpAmount, goldAmount) {
        this.xp += xpAmount;
        this.gold += goldAmount;
        
        // Level up algorithm (100 XP per level)
        const oldLvl = this.level;
        this.level = Math.floor(this.xp / 100) + 1;
        if (this.level > oldLvl) {
          setTimeout(() => {
            AudioEngine.playLevelUp();
            alert(`🎉 مبارك! ارتفعت إلى المستوى ${this.level} (Junior Dev Elite)!`);
          }, 600);
        }
        this.saveStats();
      }
    };

