    --gold-soft: #f4d28a;
    --shadow: 0 15px 35px rgba(0, 0, 0, 0.8);
    --shadow-glow: 0 0 25px rgba(232, 184, 90, 0.12);
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

