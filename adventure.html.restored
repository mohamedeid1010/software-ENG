    document.head.appendChild(style);

    // 2. Create lightbox modal elements
    const modal = document.createElement('div');
    modal.className = 'lightbox-modal';
    
    const closeBtn = document.createElement('span');
    closeBtn.className = 'lightbox-close';
    closeBtn.innerHTML = '&times;';
    
    const img = document.createElement('img');
    img.className = 'lightbox-content';
    
    const hint = document.createElement('div');
    hint.className = 'lightbox-hint';
    hint.innerText = 'اضغط في أي مكان لإغلاق الصورة';
    
    modal.appendChild(closeBtn);
    modal.appendChild(img);
    modal.appendChild(hint);
    document.body.appendChild(modal);

    // Open lightbox helper
    const openLightbox = (src) => {
      img.src = src;
      modal.classList.add('show');
      document.body.style.overflow = 'hidden';
    };

    // Close lightbox helper
    const closeModal = () => {
      modal.classList.remove('show');
      document.body.style.overflow = '';
      setTimeout(() => { img.src = ''; }, 300);
    };

    modal.addEventListener('click', (e) => {
      if (e.target !== img) {
        closeModal();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.classList.contains('show')) {
        closeModal();
      }
    });
// MISSING LINE 742
    
    function animate() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      
      // Update and draw particles
      for (let i = particles.length - 1; i >= 0; i--) {
        const p = particles[i];
        p.update();
        p.draw();
        if (p.alpha <= 0) {
          particles.splice(i, 1);
        }
      }
      
      // Periodically spawn floating background stars
      if (keepSpawning && Math.random() < 0.2) {
        particles.push(new Particle(
          Math.random() * canvas.width,
          canvas.height + 10,
          colors[Math.floor(Math.random() * colors.length)],
          false
        ));
      }
      
      animationFrameId = requestAnimationFrame(animate);
    }
    
    animate();
    
    // Mouse trailing interaction
    function handleMouseMove(e) {
      for (let i = 0; i < 2; i++) {
        particles.push(new Particle(
          e.clientX,
          e.clientY,
          colors[Math.floor(Math.random() * colors.length)],
          false
        ));
      }
    }
    overlay.addEventListener('mousemove', handleMouseMove);
    
    // Sequencing the cards
    const card1 = document.getElementById('card-step-1');
    const card2 = document.getElementById('card-step-2');
    const card3 = document.getElementById('card-step-3');
    
    // Reset states
    card1.classList.remove('active');
    card2.classList.remove('active');
    card3.classList.remove('active');
    
    // Step 1
    setTimeout(() => {
      card1.classList.add('active');
    }, 200);
    
    // Step 2
    <!-- 1. Quest Selector View -->
    <div id="quest-selector-screen" class="quest-selector-view">
      <div class="quest-intro">
        <h2>مرحباً بك في طور المغامرة التفاعلي 🎮</h2>
        <p>بدلاً من تصفح الملاحظات الجامدة، انطلق في مهام برمجية عملية مع <b>أبو عيد</b>! واجه مشاكل حقيقية تواجه الشركات الكبرى والعملاء، وحلها مستعيناً بما درسته لتجمع الذهب، وترتقي بمستواك وتثبت فهمك للمادة.</p>
      </div>

      <div class="quest-grid">
        <!-- Quest 1 -->
        <div class="quest-card unlocked" onclick="startQuest(1)">
          <div>
            <div style="display:flex; justify-content:space-between; align-items:center;">
              <span class="quest-num">Quest 01</span>
              <span id="q1-badge" class="quest-badge play">ابدأ المغامرة ⚔️</span>
            </div>
            <h3 style="margin-top:10px;">بوابة مملكة الكود</h3>
            <p style="font-size:0.85rem; color:var(--muted); margin-top:5px; line-height:1.5;">المحاضرة الأولى: مقدمة هندسة البرمجيات، مثلث التصميم، كوارث برمجية مشهورة.</p>
          </div>
          <div class="quest-meta">
            <span>الصعوبة: 🟢 سهلة</span>
            <span style="color: var(--gold-soft);">+100 XP | +50 🪙</span>
          </div>
        </div>

        <!-- Quest 2 -->
        <div class="quest-card locked">
          <div>
            <div style="display:flex; justify-content:space-between; align-items:center;">
