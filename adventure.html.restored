        let playMode = 'study'; // 'study' or 'challenge'

    function openModeSelector(id) {
      AudioEngine.playClick();
      currentQuestId = id;
      
      const quest = QuestData[id] || { title: "بوابة مملكة الكود", description: "المحاضرة الأولى: مقدمة هندسة البرمجيات" };
      document.getElementById('selected-quest-title').textContent = quest.title;
      
      let desc = "المحاضرة الأولى: مقدمة هندسة البرمجيات، مثلث التصميم، كوارث برمجية مشهورة.";
      if (id === 2) desc = "المحاضرة الثانية: صفات السوفتوير الأربعة MDEA وأخلاقيات المهنة للمهندسين.";
      if (id === 3) desc = "المحاضرة الثالثة: نماذج العمليات (Waterfall, Spiral, V-Model, Prototyping).";
      if (id === 4) desc = "المحاضرة الرابعة: قيم الـ Agile وطرق التطوير السريع للمشاريع الناشئة.";
      const container = document.getElementById('choices-container');
      container.innerHTML = '';

      const bullets = ['A', 'B', 'C', 'D'];

      step.choices.forEach((choice, idx) => {
        const btn = document.createElement('button');
        btn.className = 'choice-btn';
        btn.innerHTML = `
          <span class="bullet" style="margin-left: 15px; flex-shrink: 0;">${bullets[idx]}</span>
          <div style="display: flex; flex-direction: column; gap: 4px; text-align: right; flex: 1; width: 100%;">
            <div dir="ltr" style="text-align: right; font-family: var(--font-english); font-weight: 600; color: var(--ink); font-size: 1.05rem;">${choice.english}</div>
            <div style="font-family: var(--font-arabic); font-size: 0.85rem; color: var(--muted);">${choice.arabic}</div>
          </div>
        `;
        btn.onclick = () => selectChoice(choice, btn, step);
        container.appendChild(btn);
      });
    }

    function selectChoice(choice, btn, step) {
      const feedbackPanel = document.getElementById('feedback-panel');
      const allButtons = document.querySelectorAll('.choice-btn');

      if (choice.isCorrect) {
        // Correct answer
        AudioEngine.playCorrect();
        
        // Disable all and style correct one
        allButtons.forEach(b => {
          b.disabled = true;
          if (b === btn) {
            b.classList.add('correct');
          }
        });

        // Show positive feedback
        feedbackPanel.style.display = 'block';
        feedbackPanel.className = 'feedback-box';
        feedbackPanel.innerHTML = `🌟 <b>عاش يا وحش!</b> ${step.feedback}`;
        
        // Show next button
        document.getElementById('next-dialogue-btn').style.display = 'inline-flex';
        document.getElementById('avatar-mouth').setAttribute('d', 'M 42 61 Q 50 72 58 61'); // happy open mouth

        // Small reward
        Player.reward(15, 8);
      } else {
        // Wrong answer
        AudioEngine.playWrong();
        
        btn.classList.add('wrong');
        btn.disabled = true;

        // Lose HP/Energy
        Player.damage(15);
        document.getElementById('avatar-mouth').setAttribute('d', 'M 44 63 Q 50 59 56 63'); // sad/concerned mouth

        // Show hints
        feedbackPanel.style
// MISSING LINE 1581
// MISSING LINE 1582
// MISSING LINE 1583
// MISSING LINE 1584
// MISSING LINE 1585
// MISSING LINE 1586
// MISSING LINE 1587
