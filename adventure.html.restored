    function updateQuestGridBadges() {
      if (Player.completedQuests.includes(1)) {
        const badge = document.getElementById('q1-badge');
        badge.textContent = 'تم الإنجاز 🏆';
        badge.className = 'quest-badge conquered';
      }
    }

    function startQuest(id) {
      AudioEngine.playClick();
      currentQuestId = id;
      currentStepIdx = 0;

        document.getElementById('hud-hp').textContent = this.hp;
        document.getElementById('hud-xp').textContent = this.xp;
        document.getElementById('hud-gold').textContent = this.gold;
        document.getElementById('hud-lvl').textContent = this.level;

        // Visual alert on low HP
        const hpBadge = document.querySelector('.stat-badge.hp');
        if (this.hp <= 30) {
          hpBadge.style.animation = 'buttonPulse 1.5s infinite';
          hpBadge.style.borderColor = 'var(--red)';
        } else {
          hpBadge.style.animation = 'none';
          hpBadge.style.borderColor = 'rgba(224, 138, 122, 0.3)';
        }
      },

      damage(amount) {
        this.hp = Math.max(0, this.hp - amount);
        this.saveStats();
        if (this.hp <= 0) {
          showFaintScreen();
        }
      },

      reward(xpAmount, goldAmount) {
        this.xp += xpAmount;
        this.gold += goldAmount;
        
        // Level up algorithm (100 XP per level)
        const oldLvl = this.level;
        this.level = Math.floor(this.xp / 100) + 1;
        if (this.level > oldLvl) {
          setTimeout(() => {
